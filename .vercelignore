# Don't upload venv and heavy deps; Vercel installs from api/requirements.txt
# Exclude root pyproject.toml so Vercel uses api/requirements.txt + defaults to Python 3.12
pyproject.toml
backend/.venv
backend/node_modules
backend/__pycache__
backend/**/__pycache__
backend/*.db
backend/StockTracker_Portable*
node_modules
frontend/node_modules
*.rar
