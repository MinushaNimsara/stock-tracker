# Firebase credentials for local dev. Copy to .env and fill in.
# Option 1 (easiest): path to your Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-key.json

# Option 2: Base64-encoded JSON (no escaping issues)
# FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
